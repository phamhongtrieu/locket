PORT=3000
DATABASE_URL="file:./dev.db" # Đối với PostgreSQL dùng: postgresql://user:password@localhost:5432/locket_db
JWT_SECRET="your_jwt_secret_key"

# Cấu hình Ngân hàng cho VietQR & SePay Webhook
BANK_NAME="MBBank" # MBBank, VCB, ICB, ACB, VPB, TCB, STB, TPB, ...
BANK_ACCOUNT_NO="0987654321"
BANK_ACCOUNT_NAME="NGUYEN VAN A"

# Token xác thực webhook SePay (gửi qua Header Authorization: Apikey <SEPAY_API_KEY>)
SEPAY_API_KEY="sepay_secret_token_123456"

# Tài khoản Admin mặc định khi khởi tạo (seeding)
ADMIN_EMAIL="admin@locketgold.vn"
ADMIN_PASSWORD="admin123456"
